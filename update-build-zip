#!/usr/bin/env python3
import argparse
import os
import sys
import time
import zipfile
import warnings

try:
    import zipfile_zstd  # noqa: F401 (patches zipfile for zstd support on Python < 3.14)
except ImportError:
    pass

# Suppress UserWarning about duplicate names when appending to ZipFile
warnings.filterwarnings("ignore", category=UserWarning, module="zipfile")


def member_mtime(date_time):
    # ZipInfo date_time is (year, month, day, hour, min, sec) in local time
    return time.mktime((*date_time, -1, -1, -1))


def main():
    parser = argparse.ArgumentParser(description="Update build.zip with files matching include/exclude rules.")
    parser.add_argument("zip_path", help="Path to ZIP archive")
    parser.add_argument("root_dir", nargs="?", default=".", help="Root directory to search for files")
    parser.add_argument("--exclude", nargs="*", default=[], help="Prefixes or directories to exclude")
    parser.add_argument("--include", nargs="*", default=[], help="Prefixes or directories to include")
    args = parser.parse_args()

    zip_path = args.zip_path
    base = os.path.abspath(args.root_dir)

    # Normalize include and exclude patterns
    exclude_prefixes = tuple(p.rstrip("/*") + "/" if p.endswith("/*") else p for p in args.exclude)
    include_prefixes = tuple(p.rstrip("/*") + "/" if p.endswith("/*") else p for p in args.include)

    existing = {}
    if os.path.exists(zip_path):
        with zipfile.ZipFile(zip_path, "r") as zf:
            for member in zf.infolist():
                existing[member.filename] = member

    to_add = []
    for root, dirs, files in os.walk(base):
        rel_root = os.path.relpath(root, base)
        for f in files:
            rel_file = os.path.normpath(os.path.join(rel_root, f))
            # Format with forward slashes for zip archive
            rel_str = rel_file.replace(os.sep, "/")

            # Apply include/exclude filtering
            excluded = any(rel_str.startswith(p) for p in exclude_prefixes)
            included = any(rel_str.startswith(p) for p in include_prefixes)
            if excluded and not included:
                continue

            full_path = os.path.join(base, rel_file)
            st = os.stat(full_path)

            if rel_str in existing:
                member = existing[rel_str]
                m_time = member_mtime(member.date_time)
                # zip -u skips files that have not been modified (using 2s DOS resolution tolerance)
                if st.st_mtime <= m_time + 2 and st.st_size == member.file_size:
                    continue
                action = "updating"
            else:
                action = "adding"

            to_add.append((action, full_path, rel_str))

    if not to_add:
        # Exit code 12 matches Info-ZIP zip -u returncode when nothing to update
        sys.exit(12)

    comp = getattr(zipfile, "ZIP_ZSTANDARD", zipfile.ZIP_DEFLATED)
    with zipfile.ZipFile(zip_path, "a", compression=comp) as zf:
        for action, full_path, rel_str in to_add:
            zf.write(full_path, rel_str)
            member = zf.getinfo(rel_str)
            if member.compress_type != zipfile.ZIP_STORED and member.file_size > 0:
                pct = int(100 * (1 - member.compress_size / member.file_size))
                cmpr = f"deflated {pct}%"
            else:
                cmpr = "stored 0%"
            print(f"  {action}: {rel_str} ({cmpr})")

    sys.exit(0)


if __name__ == "__main__":
    main()
